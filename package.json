{
  "name": "oath-and-ember",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch apps/server/src/index.ts\" \"vite --config apps/client/vite.config.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build --config apps/client/vite.config.ts && tsc -p apps/server/tsconfig.json",
    "start": "node dist/apps/server/src/index.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "phaser": "4.2.1",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.2"
  }
}
